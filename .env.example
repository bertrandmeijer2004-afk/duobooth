# Salin menjadi .env lalu isi bila perlu (dibaca otomatis oleh Node 20.12+), atau set langsung di dashboard hosting.
# Semuanya opsional.

# PORT=3000
# HOST=0.0.0.0

# Server TURN (agar video lancar di data seluler / WiFi kantor):
# TURN_URL=turn:turn.contoh.com:3478,turns:turn.contoh.com:443?transport=tcp
# TURN_USERNAME=nama
# TURN_CREDENTIAL=rahasia

# Alternatif: array iceServers dalam JSON
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:turn.contoh.com:3478","username":"nama","credential":"rahasia"}]

# Alternatif: URL penyedia TURN yang mengembalikan array iceServers (kredensial sementara)
# ICE_SERVERS_URL=https://contoh.metered.live/api/v1/turn/credentials?apiKey=...
